# 在座 CLI 的可选非秘密环境设置。
# 复制到包外的私密工作目录后由你自己的终端载入；launcher 不自动执行/读取它。
# 不在此文件写真实密码、OneBot token、relay token、SSH 私钥或 URL 内嵌凭据。
# 必需秘密由当前进程安全注入：ZAIZUO_PASSWORD、ZAIZUO_ONEBOT_TOKEN。
# 可选 Git 设置必须成对启用；不要把 profile 当成 Git worktree。
ZAIZUO_GIT_REMOTE=
ZAIZUO_GIT_WORKTREE=
ZAIZUO_SYNC_INTERVAL_SECONDS=30
# 本机环回中继，仅测试/受控部署，不开启公网监听。
ZAIZUO_RELAY_URL=
# 启动器可用绝对目录把自备 Git/cwebp 加到当前子进程 PATH。
ZAIZUO_GIT_BIN_DIR=
ZAIZUO_CWEBP_BIN_DIR=
